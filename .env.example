# Copia de referencia. NO subas los valores reales al repo:
# configúralos como Variables del servicio en Railway.

# Secreto para firmar las sesiones (mín. 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarlo cierra la sesión de todo el mundo.
SESSION_SECRET=

# Un código por puesto (mín. 8 caracteres, sin distinguir mayúsculas).
# Si un puesto no tiene código, queda desactivado.
# Cambiar un código cierra al momento las sesiones abiertas de ese puesto.
CODE_COCINA=
CODE_JEFE_COCINA=
CODE_SALA=
CODE_JEFE_SALA=
CODE_OFICINA=

# Opcional: duración de la sesión en horas (por defecto 12)
# SESSION_HOURS=12
