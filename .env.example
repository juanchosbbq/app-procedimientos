# Copia de referencia. NO subas los valores reales al repo:
# configúralos como Variables del servicio en Railway.

# Secreto para firmar las sesiones (mín. 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarlo cierra la sesión de todo el mundo.
SESSION_SECRET=

# Carpeta donde se guardan los usuarios. En Railway NO hace falta si el
# servicio tiene un Volume (se usa su ruta automáticamente).
# DATA_DIR=./data

# Opcional: envío de invitaciones por correo (https://resend.com).
# Sin esto, las invitaciones se copian / envían por WhatsApp a mano.
# RESEND_API_KEY=
# MAIL_FROM=Juancho's BBQ <acceso@equipojuanchos.com>

# Opcional: duración de la sesión en horas (por defecto 12)
# SESSION_HOURS=12
